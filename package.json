{
  "name": "jiansui-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.mjs",
    "dev:web": "vite",
    "dev:lan": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web-lan\"",
    "dev:web-lan": "vite --mode lan",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:smoke": "node tests/smoke.mjs",
    "test:api": "node tests/api.mjs",
    "test:amap": "node tests/amap.mjs",
    "test:card": "node tests/photo-card.mjs",
    "test:context": "node tests/photo-context.mjs",
    "test:metadata": "node tests/metadata.mjs",
    "test:film": "node tests/memory-film.mjs",
    "test:venues": "node tests/venue-models.mjs",
    "test:landmarks": "node tests/landmark-expansion.mjs",
    "test:overview": "node tests/map-overview.mjs",
    "test:film-stories": "node --experimental-strip-types --test tests/film-stories.mjs",
    "test:skills": "node --test skills/*/test.mjs .claude/skills/*/test.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^2.0.0",
    "dotenv": "18.0.3",
    "exifr": "7.1.3",
    "heic2any": "^0.0.4",
    "idb": "8.0.3",
    "lucide-react": "1.47.0",
    "polygon-clipping": "^0.15.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "piexifjs": "^1.0.6",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
