# Personal World · 本机配置。复制为 .env 再填写；只由服务端读取，不要提交。
# `npm run check` 逐项检查这些配置和依赖，`npm run dev` 启动前会自动检查一遍。
# 每个功能依赖什么，见 README 的「功能与依赖」。

# ── AI 模型（StepFun 阶跃星辰）· 必填 ───────────────────────────────────────────────
STEPFUN_API_KEY=
# Step Plan 套餐；改成 https://api.stepfun.com/v1 会扣账户余额
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
# 需要支持图片输入（如 step-3.7-flash）
STEPFUN_MODEL=step-3.7-flash
# 边看边讲的写作模型；选题和事实复核仍用 STEPFUN_MODEL
STEPFUN_STORY_MODEL=step-5-preview

# ── 高德地图 · 必填 ─────────────────────────────────────────────────────────────────
# 高德开放平台 → 应用 → Key，平台选"Web端(JS API)"，Key 和安全密钥成对生成
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=

# ── 人物识别和回忆短片（Python 3.12 + numpy/OpenCV/Pillow + FFmpeg）────────────────
# 都在 PATH 上时保持默认。Windows 常见问题：python 可能是 Microsoft Store 的占位程序，
# winget 装的 FFmpeg 不在已打开终端的 PATH 里，这时写完整路径，例如
#   FACE_PYTHON=C:\Users\<你>\AppData\Local\Programs\Python\Python312\python.exe
#   FFMPEG_PATH=C:\Users\<你>\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\bin\ffmpeg.exe
# Linux/macOS 没有 python 命令、或没有管理员权限时，用项目里的虚拟环境：
#   FACE_PYTHON=<项目目录>/.venv/bin/python
FACE_PYTHON=python
MEMORY_FILM_PYTHON=python
# FFMPEG_PATH=ffmpeg
# 只有测试会用到 ffprobe
# FFPROBE_PATH=ffprobe
# 短片中文字幕字体；默认依次找 Windows 微软雅黑、Linux Noto Sans CJK、macOS 苹方
# MEMORY_FILM_FONT=

# ── 4D 时空场景（本机 GPU 上的 ComfyUI + Depth Anything 3）─────────────────────────
# 写上 ComfyUI 的目录后，npm run dev 会在它没运行时自动启动它，日志在 server/data/logs/comfyui.log
# COMFYUI_DIR=
# COMFYUI_PYTHON=   # ComfyUI 的 Python 不在 <COMFYUI_DIR>/venv 或 .venv 里时才需要
# COMFY_URL=http://127.0.0.1:8188

# ── 构建新地区的地图档案（npm run build:osm，Java 21+ 与 Planetiler）───────────────
# 只在自己构建地图时需要；Java 不在 PATH 上时写完整路径
# JAVA_PATH=

# ── 地图数据（world-data/*.mbtiles）─────────────────────────────────────────────────
# 启动时按 world-data/manifest.json 里的链接自动下载（多连接，可断点续传）。
# manifest 里没有链接的文件用这个模板，{name} 是文件名，例如 Seafile 文件夹分享：
# WORLD_DATA_URL=https://seafile.example.com/d/<share-token>/files/?p=/{name}&dl=1
