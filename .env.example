# Server only. Fill locally; never commit actual keys.
STEPFUN_API_KEY=
# Step Plan (subscription credit). https://api.stepfun.com/v1 bills the account balance instead
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-3.7-flash
# Optional narration writer; selection and factual review keep using STEPFUN_MODEL on the same endpoint.
STEPFUN_STORY_MODEL=step-5-preview
AMAP_JS_KEY=
AMAP_JS_SECURITY_CODE=
AMAP_WEB_SERVICE_KEY=
AMAP_MAP_STYLE=

# Local face identity and creative film tools (Python 3.12 + numpy/OpenCV/Pillow, FFmpeg).
#   winget install Python.Python.3.12 Gyan.FFmpeg
#   python -m pip install -r server/requirements-local.txt
#   python server/identity/setup_models.py        # verified face models → server/data/identity-models
# On Windows, "python" may be the Microsoft Store placeholder alias even after installing Python, and
# FFmpeg installed by winget is not on the PATH of an already-running terminal: give full paths, e.g.
#   FACE_PYTHON=C:\Users\<you>\AppData\Local\Programs\Python\Python312\python.exe
#   FFMPEG_PATH=C:\Users\<you>\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_...\bin\ffmpeg.exe
FACE_PYTHON=python
MEMORY_FILM_PYTHON=python
# FFMPEG_PATH=ffmpeg
# FACE_MODELS_DIR defaults to server/data/identity-models
MEMORY_FILM_EXPORT_DIR=./data/exports/films

# Optional local metadata review export; region preparation works without it.
MEMORY_REVIEW_LOCAL=0

# 4D spacetime scenes reconstruct a photo into a relief model on this computer through ComfyUI's
# Depth Anything 3 nodes (models/geometry_estimation/depth_anything_3_*.safetensors). Without a
# running ComfyUI the scenes show the photos and the evidence per layer only.
# COMFY_URL=http://127.0.0.1:8188

# Map data (world-data/*.mbtiles) is downloaded when the service starts from the links in
# world-data/manifest.json. Files without a link use this template ({name} = file name), e.g. a
# Seafile folder share:
# WORLD_DATA_URL=https://seafile.example.com/d/<share-token>/files/?p=/{name}&dl=1
WORLD_DATA_URL=
